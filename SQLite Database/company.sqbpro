emp_id INTEGER PRIMARY KEY AUTOINCREMENT,
name TEXT NOT NULL,
email TEXT UNIQUE,
age INTEGER CHECK(age &gt;= 18),
salary REAL DEFAULT 20000,
city TEXT DEFAULT 'Lucknow'
);

